{
  "name": "xabb-memorial-backend",
  "version": "1.0.0",
  "private": true,
  "description": "八路军西安办事处纪念馆课程设计后端基础服务",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:official": "node scripts/seedOfficialData.js",
    "seed:visit-schedules": "node scripts/seedVisitSchedules.js",
    "migrate:admin-display-name": "node scripts/migrateAdminDisplayName.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:news": "node scripts/seedOfficialNews.js",
    "seed:reviewed-people": "node scripts/seedReviewedPeople.js",
    "migrate:media-assets": "node scripts/migrateMediaAssets.js",
    "images:localize:check": "node scripts/localizeContentImages.js --dry-run",
    "images:localize": "node scripts/localizeContentImages.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "mysql2": "^3.14.3",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
